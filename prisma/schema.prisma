// Neon Postgres. Vercel Marketplace 연동 시 DATABASE_URL / DIRECT_URL 자동 주입
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon 풀링 엔드포인트 (서버리스 런타임용)
  directUrl = env("DIRECT_URL") // 직접 연결 (마이그레이션 전용)
}

model List {
  id        String   @id @default(cuid())
  ownerId   String   @default("local")
  name      String
  color     String?
  createdAt DateTime @default(now())
  places    Place[]
}

model Place {
  id      String @id @default(cuid())
  ownerId String @default("local")

  // 'place' = 가고 싶은 곳 | 'item' = 사고 싶은 것(향수·의류 등).
  // 겹치는 필드가 대부분이라 테이블을 나누지 않고 구분자만 뒀다.
  // item 은 region·address·lat·lng·visits 를 쓰지 않는다.
  kind String @default("place")

  name     String
  memo     String?
  category String?

  // 상권 단위 지역 프리셋 (src/lib/taxonomy.ts). 행정구역이 아니다.
  region String?

  // 2=꼭 가야 해 / 1=보통 / 0=천천히. 목록 정렬 키라서 정수다.
  priority Int @default(1)

  // 위치 (Track 1에서는 비워둬도 됨 / Track 2에서 자동 채움)
  address String?
  lat     Float?
  lng     Float?
  mapId   String? // 나중에 카카오 place_id

  // 출처 (Track 2 대비: 'manual' | 'ig_share' | 'ig_import')
  source    String  @default("manual")

  // 사람이 여는 링크. 게시물 퍼머링크이거나 직접 적은 아무 주소다.
  sourceUrl String?

  // 대표 이미지를 받아올 주소. Meta 가 퍼머링크 대신 준 첨부 CDN 주소가 여기 들어간다.
  // 서명이 만료되면 죽는 주소라서 sourceUrl 과 분리한다. 링크로는 내보내지 않는다.
  thumbnailUrl String?

  status String @default("wishlist") // wishlist | visited | skipped

  listId String?
  list   List?   @relation(fields: [listId], references: [id], onDelete: SetNull)

  visits           Visit[]
  media            Media[]
  instagramImports InstagramImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([ownerId, status, priority])
  @@index([ownerId, region])
  @@index([ownerId, kind, status])
}

// Instagram DM으로 공유된 게시물을 장소로 정리하기 전까지 보관하는 수집함.
// Meta가 같은 Webhook을 재전송할 수 있으므로 messageId + dedupeKey 조합으로 중복을 막는다.
model InstagramImport {
  id          String   @id @default(cuid())
  ownerId     String   @default("local")
  messageId   String
  senderId    String?
  recipientId String?

  // 게시물 퍼머링크. Meta 가 첨부 CDN 주소만 보내면 null 이다.
  sourceUrl String?

  // 첨부 미디어 CDN 주소. 썸네일을 받는 데만 쓰고 링크로는 쓰지 않는다.
  mediaUrl String?

  // 재전송 중복을 막는 키 (sourceUrl ?? mediaUrl).
  // sourceUrl 이 nullable 이 되면서 (messageId, sourceUrl) 유니크로는 NULL 행을 못 막는다.
  dedupeKey String

  messageText String?
  status      String   @default("pending") // pending | converted | ignored
  receivedAt  DateTime

  placeId String?
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, dedupeKey])
  @@index([ownerId, status, receivedAt])
  @@index([placeId])
}

model Visit {
  id      String @id @default(cuid())
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  visitedOn  DateTime
  rating     Int? // 1~5
  revisit    String? // yes | maybe | no
  note       String?
  spent      Int?
  companions String? // 쉼표 구분 (Postgres 이전 시 text[] 로 승격 가능)

  media     Media[]
  createdAt DateTime @default(now())

  @@index([placeId, visitedOn])
}

model Media {
  id      String  @id @default(cuid())
  placeId String
  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  kind String // reference(인스타 스크린샷) | visit(방문 사진)
  path String // storage 키. 로컬=상대경로, 클라우드=오브젝트 키

  // EXIF에서 추출
  takenAt DateTime?
  lat     Float?
  lng     Float?

  createdAt DateTime @default(now())

  @@index([placeId])
}
