# ── Neon Postgres ──────────────────────────────────────────────
# Vercel Marketplace 에서 Neon 을 연결하면 두 값이 자동 주입된다.
# 로컬 개발은 `vercel env pull .env.local` 로 받아오거나 직접 붙여넣기.
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DIRECT_URL="postgresql://.../neondb?sslmode=require"

# ── 비밀번호 게이트 ────────────────────────────────────────────
# APP_PASSWORD : 앱에 들어갈 때 입력하는 공유 비밀번호
# AUTH_SECRET  : 쿠키 서명용. `openssl rand -hex 32` 로 생성
APP_PASSWORD="바꿔주세요"
AUTH_SECRET=""

# ── 사진 저장 ──────────────────────────────────────────────────
# Vercel Blob 스토어를 연결하면 자동 주입된다.
# 이 값이 없으면 로컬 파일시스템(data/uploads)으로 자동 폴백한다.
# BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./data/uploads"
