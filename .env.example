# ── Neon Postgres ──────────────────────────────────────────────
# Vercel Marketplace 에서 Neon 을 연결하면 두 값이 자동 주입된다.
# 로컬 개발은 `vercel env pull .env.local` 로 받아오거나 직접 붙여넣기.
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DIRECT_URL="postgresql://.../neondb?sslmode=require"

# ── 비밀번호 게이트 ────────────────────────────────────────────
# APP_PASSWORD : 앱에 들어갈 때 입력하는 공유 비밀번호
# AUTH_SECRET  : 쿠키 서명용. `openssl rand -hex 32` 로 생성
APP_PASSWORD="바꿔주세요"
AUTH_SECRET=""

# ── 사진 저장 ──────────────────────────────────────────────────
# Vercel Blob 스토어를 연결하면 자동 주입된다.
# 이 값이 없으면 로컬 파일시스템(data/uploads)으로 자동 폴백한다.
# BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./data/uploads"

# ── Instagram DM 수집 Webhook ─────────────────────────────────
# INSTAGRAM_ACCOUNT_ID: Meta 대시보드에 표시되는 수집용 프로페셔널 계정 ID
# INSTAGRAM_APP_SECRET: "Instagram 로그인이 포함된 API 설정"의 Instagram 앱 시크릿
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN: 직접 생성한 긴 임의 문자열. Meta 콜백 설정에도 똑같이 입력
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
